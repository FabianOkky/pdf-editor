# Copy to .env and set a strong secret.
# PDF_SERVICE_SECRET MUST match Laravel's PDF_SERVICE_SECRET (root .env).
PDF_SERVICE_SECRET=change-me-to-a-long-random-string
PDF_SERVICE_ENV=local
PDF_SERVICE_VERSION=0.1.0

# OCR / Word export (Phase 5). PyMuPDF's bundled Tesseract needs only the language data files;
# download <lang>.traineddata into tessdata/ (see tessdata/README.md). Defaults are fine.
# PDF_TESSDATA_PREFIX=./tessdata
# PDF_OCR_LANGUAGE=eng
# PDF_OCR_DPI=200
# PDF_OCR_CACHE_DIR=./.ocr_cache

# AI assistant (Phase 6). The LLM provider key lives ONLY here (server-side) — never in Laravel
# or the browser. Set ANTHROPIC_API_KEY to enable chat/summarize/translate; without it the
# extract-text and embed endpoints still work, but the LLM endpoints return an error.
#
# AI_PROVIDER is the FALLBACK backend used only when Laravel sends no provider. The assistant
# panel has a per-request model toggle (its choice wins), so this just sets the default:
#   anthropic — Claude; needs ANTHROPIC_API_KEY.
#   gemini    — Google AI Studio; needs GEMINI_API_KEY (free tier may need billing).
#   ollama    — a local Ollama daemon; offline, no key (just `ollama pull <model>`).
# AI_PROVIDER=ollama
# AI_MAX_TOKENS=2048
#
# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-4-8
#
# Google Gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash
#
# Ollama (local)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b
#
# Embeddings: "hash" (default, deterministic, no key, offline), "voyage" (real semantic
# vectors, needs VOYAGE_API_KEY), or "ollama" (local, e.g. nomic-embed-text). If you switch
# providers, re-index documents — vectors from different models are not comparable.
# AI_EMBEDDING_PROVIDER=hash
# AI_EMBEDDING_DIM=256
# AI_EMBEDDING_MODEL=voyage-3.5-lite
# VOYAGE_API_KEY=
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
