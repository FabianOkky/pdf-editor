APP_NAME="PDF Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pdf_editor
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# PDF microservice (Python FastAPI). Secret must match pdf-service/.env.
PDF_SERVICE_URL=http://127.0.0.1:8001
PDF_SERVICE_SECRET=
PDF_SERVICE_TIMEOUT=30
# Upload limits (Phase 1). max_upload_mb also raises Livewire's temporary-upload cap.
PDF_MAX_UPLOAD_MB=25
PDF_MAX_PAGES=500

# AI assistant (Phase 6). For local dev the provider keys live in pdf-service/.env; Docker
# Compose reads them from THIS file to pass into the pdf-service container. Leave the keys blank
# to run without the LLM (extract-text + hash embeddings still work).
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
AI_EMBEDDING_PROVIDER=hash
# VOYAGE_API_KEY=
# The assistant panel has a model toggle (Local Ollama vs cloud Gemini); this is the initial
# choice and the values below are display-only labels (the real models live in pdf-service/.env).
AI_DEFAULT_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:3b
# GEMINI_MODEL=gemini-2.0-flash

# Docker Compose only (ignored by Herd/local dev). Host port mapping for the stack; DB_PASSWORD
# above doubles as the Postgres password inside the compose network (set a strong value).
APP_PORT=8080
FORWARD_DB_PORT=5432

VITE_APP_NAME="${APP_NAME}"
